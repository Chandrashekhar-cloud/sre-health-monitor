#!/bin/bash
# shellcheck disable=SC2034

# SRE Health Monitor - Runtime Configuration

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

LOG_FILE="$SCRIPT_DIR/logs/health.log"
REPORT_DIR="$SCRIPT_DIR/reports"

SERVER_NAME=$(hostname)

RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[1;33m"
BLUE="\033[0;34m"
CYAN="\033[0;36m"
BOLD="\033[1m"
RESET="\033[0m"
